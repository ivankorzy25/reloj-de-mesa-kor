<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos de base -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Agenda: solo lectura, para la tarjeta del próximo evento. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />

    <!-- Visibilidad de paquetes (target 30+): la lista de widgets del sistema y de apps para
         elegir de cuáles se muestran avisos. Sin esto, la lista sale vacía y sin nombres. -->
    <queries>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StandBy">

        <!-- Puerta de entrada: la guía de la primera vez y, después, los ajustes. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El modo en sí: sobre la pantalla de bloqueo, en su propia tarea, fuera de «Recientes». -->
        <activity
            android:name=".standby.StandbyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi"
            android:showWhenLocked="true"
            android:taskAffinity="${applicationId}.standby"
            android:theme="@style/Theme.StandBy.Fullscreen"
            android:turnScreenOn="true" />

        <service
            android:name=".service.StandbyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mira la carga y la posición del teléfono para mostrar el reloj de mesa" />
        </service>

        <!-- Avisos de notificaciones sobre el modo. El acceso lo da Iván en los ajustes del sistema. -->
        <service
            android:name=".notifications.StandbyNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Mosaico en la cortina de ajustes rápidos: el interruptor principal. -->
        <service
            android:name=".service.StandbyTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_standby"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Órdenes por adb para probar (solo quien tiene el permiso DUMP: adb y el sistema). -->
        <receiver
            android:name=".service.CommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.realfamousbae.standby.dock.SHOW_NOW" />
                <action android:name="com.realfamousbae.standby.dock.HIDE_NOW" />
                <action android:name="com.realfamousbae.standby.dock.DEMO" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
